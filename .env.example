# ==============================================================================
# DailyFlow - Environment Variables Template (.env.example)
# Copia este archivo a .env.local y completa los valores correspondientes
# ==============================================================================

# 1. Base de datos PostgreSQL (Recomendado: Neon Database Serverless)
# Formato: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/dailyflow?sslmode=require"

# 2. NextAuth.js (v5 Beta)
# Secreto para firmar cookies de sesión y JWT (genera uno con: openssl rand -base64 32)
AUTH_SECRET="tu_secreto_aleatorio_super_seguro_de_al_menos_32_caracteres"

# URL base de la aplicación (en desarrollo http://localhost:3000, en producción tu dominio)
NEXTAUTH_URL="http://localhost:3000"

# 3. Vercel Blob Storage (Para almacenamiento de imágenes y evidencias)
# Se obtiene en el panel de Vercel > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
